    "test:discovery": "node skills/3lens/scripts/run-discovery-eval.mjs",
    "test:stability": "node skills/3lens/scripts/run-stability-eval.mjs",
    "test:stability-harness": "node skills/3lens/scripts/run-stability-eval.mjs",
    "test:stability-recorded": "node skills/3lens/scripts/run-stability-eval.mjs --runs-dir evals/recorded-runs",
    "test:stability-live": "node skills/3lens/scripts/run-stability-eval.mjs --runs-dir evals/live-runs",
