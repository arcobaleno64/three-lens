    "test:evals": "node skills/3lens/scripts/run-evals.mjs",
    "test:adversarial": "node skills/3lens/scripts/run-evals.mjs",
    "test:semantic": "node skills/3lens/scripts/run-semantic-eval.mjs",
    "test:disposition": "node skills/3lens/scripts/run-semantic-eval.mjs",
