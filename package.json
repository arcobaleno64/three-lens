    "benchmark:live:holdout:paired": "node scripts/run-live-model-benchmark.mjs --suite holdout --include-safe --label-blind --passes 3 --out-dir evals/live-runs/holdout-paired --resume --delay-ms 2000 --hermetic --shuffle-seed 20260917 --protocol evals/protocols/v1.5-eval-1.json --report reports/holdout-paired-baseline-report-2026-09-17.md",
    "benchmark:live:ablation:medium": "node scripts/run-live-model-benchmark.mjs --suite holdout --include-safe --label-blind --passes 3 --out-dir evals/live-runs/reasoning-ablation/medium --resume --delay-ms 2000 --hermetic --shuffle-seed 20260917 --protocol evals/protocols/v1.5-g5-ablation-execution-1.json --model gemini-3.8-flash-medium --base-model gemini-3.8-flash --reasoning-profile medium",
    "check:protocol": "node scripts/run-live-model-benchmark.mjs --check-protocol evals/protocols/v1.5-eval-1.json",
    "check:cross-model-protocol": "node scripts/compare-model-benchmarks.mjs --verify-protocol evals/protocols/v1.5-cross-model-protocol.json",
    "compare:models": "node scripts/compare-model-benchmarks.mjs",
    "validate:v2-corpus": "node scripts/validate-v2-corpus.mjs",
    "compare:ablation:medium-high": "node scripts/compare-model-benchmarks.mjs --runs-a evals/live-runs/holdout-paired --runs-b evals/live-runs/reasoning-ablation/medium --protocol evals/protocols/v1.5-cross-model-protocol.json --report reports/reasoning-ablation-report-2026-09-17.md",
    "compare:ablation:corrected": "node scripts/compare-model-benchmarks.mjs --runs-a evals/live-runs/holdout-paired --runs-b evals/live-runs/reasoning-ablation/medium --protocol evals/protocols/v1.5-cross-model-protocol.json --report reports/reasoning-ablation-report-2026-09-17-corrected.md",
    "test:comparison": "node scripts/test-cross-model-protocol.mjs",
    "test:confinement": "node scripts/test-runtime-confinement.mjs",
    "test:hooks": "node --test tests/test-pre-invocation-secret-guard.mjs",
    "test:lifecycle": "node --test tests/test-finished-reason-governance.mjs",
    "test:authority": "node --test tests/test-effort-authority-promotion-invariants.mjs",
    "test:acp": "node --test tests/test-acp-transport-governance.mjs",
    "test:plugin-data": "node --test tests/test-plugin-data-adapter.mjs",
    "test:compact": "node --test tests/test-compact-context-governance.mjs",
    "benchmark:confinement": "node scripts/run-confinement-matrix.mjs --report reports/runtime-confinement-report-2026-09-22.md",
    "benchmark:live:n3": "node scripts/run-live-model-benchmark.mjs --passes 3 --out-dir evals/live-runs",
    "benchmark:live:n5": "node scripts/run-live-model-benchmark.mjs --passes 5 --out-dir evals/live-runs",
    "benchmark:live:safe:smoke": "node scripts/run-live-model-benchmark.mjs --safe-only --fixture SEM-01-SAFE --passes 3 --out-dir evals/live-runs/safe-smoke",
    "benchmark:live:safe:baseline": "node scripts/run-live-model-benchmark.mjs --safe-only --passes 3 --out-dir evals/live-runs/safe-baseline --resume --delay-ms 2000",
    "benchmark:live:safe:n10": "node scripts/run-live-model-benchmark.mjs --safe-only --passes 10 --out-dir evals/live-runs/safe-n10",
    "test:safe-control:mock": "node scripts/run-live-model-benchmark.mjs --safe-only --mock --passes 3",
    "test:harness": "node scripts/run-live-model-benchmark.mjs --test",
    "benchmark:canary": "node scripts/run-runtime-canary.mjs",
    "benchmark:oss": "node scripts/run-oss-transfer-eval.mjs",
    "compare:cross-provider": "node scripts/compare-model-benchmarks.mjs --runs-a evals/live-runs/cross-provider/gemini --runs-b evals/live-runs/cross-provider/claude --protocol evals/protocols/v1.6-g8r-cross-provider-protocol.json --report reports/cross-provider-replication-report-2026-09-23.md --evidence-grade L3_CROSS_PROVIDER_OBSERVED --timestamp 2026-09-23T03:38:45.948Z",
    "test:evidence-matrix": "node scripts/test-evidence-matrix-gate.mjs",
    "test:provenance": "node scripts/test-release-provenance.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:doctor": "node scripts/test-doctor.mjs",
    "check:reproducibility": "node scripts/run-reproducibility-check.mjs",
    "test:reproducibility": "node scripts/test-reproducibility.mjs",
    "check:micro-corpus": "node scripts/run-micro-corpus.mjs",
    "test:micro-corpus": "node scripts/test-micro-corpus.mjs",
    "test:operator-metrics": "node scripts/test-operator-metrics.mjs"
